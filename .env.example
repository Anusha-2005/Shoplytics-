# ==============================================================================
# Shoplytics Environment Configuration Template
# Copy this file to .env and customize with your local settings.
# ==============================================================================

# Dataset Directory (Location of Olist CSV files on your Windows machine)
# Example: C:/Users/<YourUsername>/Downloads or ./data/raw
DATASET_DIR=C:/Users/anura/Downloads

# Processed Data Directory
PROCESSED_DATA_DIR=./data/processed

# Database Engine: 'mysql' or 'sqlite'
DB_ENGINE=sqlite

# MySQL Connection Parameters (Used when DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shoplytics
DB_USER=root
DB_PASSWORD=

# SQLite Database Path (Used when DB_ENGINE=sqlite or fallback)
SQLITE_DB_PATH=./data/shoplytics.db

# Analytics & Logging Configuration
LOG_LEVEL=INFO
CHUNK_SIZE=10000
